JOBLOOM_AI_HOST=127.0.0.1
JOBLOOM_AI_PORT=8000
JOBLOOM_AI_RELOAD=true

# mock = empty requests use local mock fixtures.
# real = requests must include real payloads.
JOBLOOM_AI_DATA_SOURCE=real

JOBLOOM_AI_HEALTH_PATH=/ai/health
JOBLOOM_AI_PARSE_CV_PATH=/ai/parse-cv
JOBLOOM_AI_REFRESH_PROFILE_SECTION_PATH=/ai/suggest-profile-section
JOBLOOM_AI_VERIFY_TRANSCRIPT_PATH=/ai/verify-transcript
JOBLOOM_AI_RANK_JOBS_PATH=/ai/rank-jobs
JOBLOOM_AI_RANK_STUDENTS_PATH=/ai/rank-students

# mock = deterministic fallback only.
# gemini = use Gemini for extraction/classification.
JOBLOOM_AI_LLM_PROVIDER=gemini
JOBLOOM_AI_GEMINI_API_KEY=AIzaSyBrpd_pvYjzqh_LuneIQOD32j0uos9jLp4
JOBLOOM_AI_GEMINI_MODEL=gemini-2.5-flash
JOBLOOM_AI_LLM_TIMEOUT_SECONDS=30
JOBLOOM_AI_LLM_TEMPERATURE=0.2
JOBLOOM_AI_LLM_MAX_OUTPUT_TOKENS=512
