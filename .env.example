JOBLOOM_AI_HOST=127.0.0.1
JOBLOOM_AI_PORT=8000
JOBLOOM_AI_RELOAD=true

# mock = empty Postman requests use local mock fixtures.
# real = requests must include real student/job payloads from the backend.
JOBLOOM_AI_DATA_SOURCE=mock

JOBLOOM_AI_HEALTH_PATH=/ai/health
JOBLOOM_AI_RANK_JOBS_PATH=/ai/rank-jobs
JOBLOOM_AI_RANK_STUDENTS_PATH=/ai/rank-students
